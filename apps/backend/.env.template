# Capital.com DEMO login (the code only ever talks to the demo API)
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=

# Lab PostgreSQL (1-minute candles)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=trader
PG_USER=
PG_PASSWORD=

# Arena API and the GPU forecaster (loopback on this PC)
ARENA_URL=http://127.0.0.1:4120
ARENA_TOKEN=
FORECASTER_URL=http://127.0.0.1:4130

# The shared server (kept out of git). Its user's home is mirrored on the PC as the arena/UI runtime root
# (ops/server/runtime.sh, src/lab/runtime.ts); the SSH target serves the public edge and the Hetzner fallback.
TRADER_SERVER_SSH=<server-user>@<server-ip>
TRADER_SERVER_HOME=/home/<server-user>

# --- arena only (runtime .env) ---
# ARENA_PORT=4120
# ARENA_DB=<runtime>/trader-arena/data/arena.db
# BROKER_ACCOUNT_PREFIX=Arena   # demo accounts named Arena… are used by the broker mirror; "off" disables it
