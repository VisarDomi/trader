[Unit]
Description=Trader SSH tunnel (lab forecaster -> arena, arena API -> lab)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Slice=trader.slice
# Only for an arena on the shared server; ops/lab/install.sh disables it while the PC runtime is active.
# -R: the arena on the server reaches the GPU forecaster at its 127.0.0.1:4130
# -L: lab jobs push backtests to the arena API at 127.0.0.1:4120
# The SSH target (TRADER_SERVER_SSH) comes from apps/backend/.env through ops/server/runtime.sh.
ExecStart=/bin/bash -c 'source %h/Documents/work/trading/trader/ops/server/runtime.sh && exec /usr/bin/autossh -M 0 -N \
    -o "ServerAliveInterval=15" \
    -o "ServerAliveCountMax=3" \
    -o "ExitOnForwardFailure=yes" \
    -o "ConnectTimeout=10" \
    -R 127.0.0.1:4130:127.0.0.1:4130 \
    -L 127.0.0.1:4120:127.0.0.1:4120 \
    "$${TRADER_SERVER_SSH}"'
Restart=always
RestartSec=10
Environment=AUTOSSH_GATETIME=0

[Install]
WantedBy=default.target
