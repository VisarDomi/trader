[Unit]
Description=Trader arena (live demo forward-testing of trading agents)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Template: ops/server/deploy-arena.sh fills in @SERVER_USER@ and @SERVER_HOME@ from apps/backend/.env.
User=@SERVER_USER@
WorkingDirectory=@SERVER_HOME@/trader-arena/app
EnvironmentFile=@SERVER_HOME@/trader-arena/.env
Environment=BUN_JSC_numberOfGCMarkers=1
ExecStart=/usr/local/bin/bun src/arena/main.ts
Restart=always
RestartSec=10
TimeoutStopSec=30
# The server is shared: keep the arena small and polite.
MemoryHigh=500M
MemoryMax=700M
CPUQuota=100%
Nice=5

[Install]
WantedBy=multi-user.target
